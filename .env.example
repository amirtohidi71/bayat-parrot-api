NODE_ENV=development
SMS_ENABLED=false
SMS_DEV_LOG_OTP=false
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_API_KEY=replace-with-ippanel-api-key
IPPANEL_FROM_NUMBER=replace-with-sender-number

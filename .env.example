NODE_ENV=development
SMS_ENABLED=false
SMS_DEV_LOG_OTP=false
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_API_KEY=replace-with-ippanel-api-key
IPPANEL_FROM_NUMBER=replace-with-sender-number
IPPANEL_OTP_PATTERN_CODE=replace-with-pattern-code
IPPANEL_TIMEOUT_MS=5000
VET_FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
VET_PAYMENT_HOLD_SECONDS=900
VET_VIDEO_JOIN_BEFORE_MINUTES=15
VET_VIDEO_GRACE_AFTER_MINUTES=15
VET_VIDEO_ACCESS_TOKEN_SECONDS=60
VET_DOCTOR_JWT_SECRET=replace-with-dedicated-vet-doctor-jwt-secret
VET_DOCTOR_JWT_TTL_SECONDS=900
LIVEKIT_URL=wss://replace-with-livekit-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
